{
  "name": "@functional-systems/srcx",
  "version": "0.1.0-dev.1",
  "private": false,
  "description": "Version-aware code search on LambdaDB",
  "type": "module",
  "bin": {
    "srcx": "dist/cli.js"
  },
  "files": [
    "dist",
    "runtime/qwen.py",
    "runtime/grammars",
    "runtime/requirements.txt",
    "README.md",
    "DESIGN.md",
    "VALIDATION.md",
    "src",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-timeout=60000 test/*.test.mjs",
    "start": "node dist/cli.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepack": "npm run build",
    "format": "prettier --write src test scripts eval README.md VALIDATION.md CONTRIBUTING.md RELEASING.md CHANGELOG.md .github package.json tsconfig.json",
    "format:check": "prettier --check src test scripts eval README.md VALIDATION.md CONTRIBUTING.md RELEASING.md CHANGELOG.md .github package.json tsconfig.json",
    "test:live": "npm run build && node --env-file=.env.local scripts/live.mjs",
    "check:version": "node scripts/check-release.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:live:branches": "npm run build && node --env-file=.env.local scripts/live-branches.mjs",
    "eval:prepare": "npm run build && node scripts/retrieval-eval.mjs prepare",
    "eval:run": "node scripts/retrieval-eval.mjs run",
    "eval:cli:prepare": "npm run build && node scripts/cli-eval.mjs prepare",
    "eval:cli:run": "node scripts/cli-eval.mjs run",
    "eval:modes:prepare": "npm run build && node scripts/cli-eval.mjs prepare --suite eval/retrieval-modes-v1.json --root .srcx/mode-eval",
    "eval:modes:run": "node scripts/cli-eval.mjs run --root .srcx/mode-eval"
  },
  "dependencies": {
    "@functional-systems/lambdadb": "0.5.1",
    "commander": "14.0.3",
    "js-tiktoken": "1.0.21",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "prettier": "3.9.9",
    "typescript": "5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdadb/srcx.git"
  },
  "homepage": "https://github.com/lambdadb/srcx#readme",
  "bugs": {
    "url": "https://github.com/lambdadb/srcx/issues"
  },
  "license": "Apache-2.0"
}
